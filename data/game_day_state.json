  "one_page_notes": {
    "alexclaudio": "Heavy low slot sinker, CH mimics SNK movement, SL is cuttery. CH to RHH, SL to LHH",
    "alexsantos": "Avg FB movement, good sweeper with lift and sweep. Cutter to LHH SW to RHH. Wide release",
    "andrewmarrero": "Avg. ride on 4S, high release. SL has some sweep, 50/50 FB SL to RHH",
    "charleesoto": "Ride and run, short slider, most pitches move arm side. Damage up and in to LHH, middle to RHH.",
    "derekwest": "High velo, avg 4S shape, some sweep to SL mid 80s uses more to RHH. Leans heavy FB and gets it in zone top rail. Damage middle up. ",
    "ericgarcia": "4S and SL only - 4S no ride. SL is a short slurve. 75% FB",
    "erictorres": "Run on FB, Sweeper to LHH, low/wide release",
    "erikrivera": "Some ride on FB, short slider, high extension. Damage in to RHH.",
    "gabrielrodriguez": "Ride on FB, low spin on splitter, wobbles - throws to RHH. high release. Short slider to LHH",
    "haroldcortijo": "FB does not have ride, SL is gyro shape, CH has good depth and throws only to LHH",
    "hectorquinones": "Damage down, average release height, SL to RHH, SP to LHH",
    "johnaponte": "Extension and low release height. works up with FB",
    "jonathanbermudez": "FB average shape, primary offspeed big sweeper, average CH, flashes SL/CT shape vs LHH",
    "jorhanlaboy": "Upper 80's LHP, CB and CH are offspeed pitches",
    "josecruz": "FB SL to RHH and FB CH to LHH, up to low 90s, avg slot. RHH get extended, damage up and away, LHH damage middle in.",
    "juanmarcano": ">50% FB, leans on SL to RHH, some CH to LHH",
    "juliotorres": "High FB usage, damage middle and in to RHH. Low velocity.",
    "kaiyokogawa": "Damage away from RHH, down to LHH. Works CT CB SL and SP. Leans fb but throws all pitches",
    "keitomatsuura": "High FB usage, low 90's",
    "lennytorres": "Some ride and run, high velocity. short slider to RHH. Some SNK with some run no sink. CH has some depth.",
    "lucasvega": "High FB usage, low slow. Only uses SL as non-FB - some sweep.",
    "luisramos": "Low slot LHP with extension, upper 80s with low 80s short SL.",
    "mariozabala": "Good extension, some ride and short slider. High FB usage. See it up.",
    "michaelmorales": "Avg. ride, some cut to 4S. Good extension. Sweeper to RHH, CB/CT to LHH. CB has depth and sweep",
    "noelpinto": "Tons of FB, CH to RHH. Damage down in zone",
    "omarmelendez": "High release, leans on FB, CH to RHH, spin to LHH",
    "rickycastro": "Ride on FB, high release. CH has some depth, CT is primary BB. More SL to RHH, CH to LHH",
    "ryanmunoz": "High slot LHP. FB SL only, SL has depth and is scurvy. Damage middle in to RHH and same to LHH. Gets ahead and throws mostly SL unless behind in count.",
    "ryanmurphy": "Hitch in delivery, SL for chase to RHH, SNK primary"
  },
